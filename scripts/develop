#!/usr/bin/env bash
# Run a live Home Assistant dev instance with this integration loaded.
# HA itself comes from the ha-venv (version pinned via pytest-homeassistant-custom-component).
# config/configuration.yaml is versioned; runtime state under config/ is gitignored.
set -e
cd "$(dirname "$0")/.."

mkdir -p config
if [[ ! -e "${PWD}/config/custom_components" ]]; then
    ln -s ../custom_components "${PWD}/config/custom_components"
fi

hass --config "${PWD}/config" --debug
